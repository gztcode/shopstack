/* 订单选择 ------------------------------------------------------------ */
.order {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.order__body {
  flex: 1;
  min-width: 0;
}

.order__no {
  display: block;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-medium);
  color: var(--ss-color-text-primary);
}

.order__time {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.order__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.order__status {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-brand);
}

.order__amount {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

/* 发货单 -------------------------------------------------------------- */
.shipment {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.shipment__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.shipment__info {
  flex: 1;
  min-width: 0;
}

.shipment__company {
  display: block;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.shipment__no {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-brand);
}

.shipment__row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 10rpx 0;
  font-size: var(--ss-font-size-sm);
}

.shipment__label {
  width: 140rpx;
  flex-shrink: 0;
  color: var(--ss-color-text-tertiary);
}

.shipment__value {
  flex: 1;
  color: var(--ss-color-text-secondary);
  word-break: break-all;
}

/* 轨迹 ---------------------------------------------------------------- */
.track {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.track__node {
  width: 18rpx;
  height: 18rpx;
  border-radius: var(--ss-radius-circle);
  background: var(--ss-color-border-strong);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.track__node--active {
  background: var(--ss-color-brand-600);
  box-shadow: 0 0 0 6rpx var(--ss-color-brand-50);
}

.track__body {
  flex: 1;
  min-width: 0;
}

.track__desc {
  display: block;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  line-height: var(--ss-font-line-height-relaxed);
}

.track__time {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

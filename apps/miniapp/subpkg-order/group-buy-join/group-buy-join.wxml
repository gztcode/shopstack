<view class="ss-page join">
  <demo-banner />

  <loading wx:if="{{loading}}" type="detail" />

  <block wx:if="{{!loading && groupBuy}}">
    <view class="ss-card join__goods">
      <image class="join__cover" src="{{groupBuy.product_cover}}" mode="aspectFill" />
      <view class="ss-flex-1">
        <text class="join__name ss-ellipsis-2">{{groupBuy.name}}</text>
        <view class="join__price-row">
          <text class="join__price">¥{{groupBuy.price_text}}</text>
          <text class="join__origin">¥{{groupBuy.original_text}}</text>
        </view>
        <text class="join__meta">{{groupBuy.joined_count}}/{{groupBuy.group_size}} 人已参团 · {{groupBuy.status_text}}</text>
      </view>
    </view>

    <view class="ss-section-title">
      <text>选择收货地址</text>
      <text class="ss-section-title__more" bindtap="onEditAddress">管理地址 ›</text>
    </view>

    <view class="ss-card join__addresses">
      <view
        class="join__address {{addressId === item.id ? 'join__address--active' : ''}}"
        wx:for="{{addresses}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onAddressTap"
      >
        <view class="ss-flex-1">
          <text class="join__receiver">{{item.receiver}} {{item.phone}}</text>
          <text class="join__detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
        </view>
        <text class="ss-tag ss-tag--muted" wx:if="{{item.is_default}}">默认</text>
      </view>
    </view>

    <view class="ss-card join__amount">
      <view class="join__amount-row">
        <text class="join__amount-label">拼团价</text>
        <text class="ss-price">¥{{groupBuy.price_text}}</text>
      </view>
      <view class="join__amount-row">
        <text class="join__amount-label">单买价</text>
        <text class="join__origin">¥{{groupBuy.original_text}}</text>
      </view>
    </view>
  </block>

  <view class="ss-action-bar" wx:if="{{!loading && groupBuy}}">
    <view class="ss-btn ss-btn--primary ss-flex-1" bindtap="onSubmit">
      {{submitting ? '提交中' : (groupBuy.status === 1 ? '立即参团' : '拼团已结束')}}
    </view>
  </view>
  <view class="ss-action-bar__spacer" wx:if="{{!loading && groupBuy}}"></view>

  <view class="join__result" wx:if="{{joined}}">
    <text class="join__result-title">已加入该拼团，可在「我的拼团」中查看进度</text>
    <view class="ss-btn ss-btn--ghost ss-btn--sm" bindtap="onGoMine">查看我的拼团</view>
  </view>
</view>

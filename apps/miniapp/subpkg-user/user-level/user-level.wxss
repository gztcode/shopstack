.level__hero {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 24rpx;
  border-radius: var(--ss-radius-lg);
  background: var(--ss-gradient-hero);
  box-shadow: var(--ss-shadow-brand);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--ss-color-text-inverse);
}

.level__icon {
  font-size: 64rpx;
}

.level__name {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
}

.level__discount {
  font-size: var(--ss-font-size-sm);
  padding: 4rpx 20rpx;
  border-radius: var(--ss-radius-pill);
  background: rgba(255, 255, 255, 0.18);
}

.level__growth {
  font-size: var(--ss-font-size-sm);
  opacity: 0.85;
}

.level__bar {
  width: 100%;
  height: 12rpx;
  border-radius: var(--ss-radius-pill);
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
  margin-top: 12rpx;
}

.level__bar-inner {
  height: 100%;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-gradient-accent);
}

.level__next {
  font-size: var(--ss-font-size-xs);
  opacity: 0.85;
  margin-top: 8rpx;
}

.level__benefits {
  margin: 0 24rpx;
  padding: 8rpx 24rpx;
}

.level__benefit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.level__benefit:last-child {
  border-bottom: none;
}

.level__benefit-dot {
  color: var(--ss-color-text-success);
}

.level__list {
  margin: 0 24rpx;
  padding: 8rpx 24rpx;
}

.level__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.level__item:last-child {
  border-bottom: none;
}

.level__item--reached {
  opacity: 1;
}

.level__item-icon {
  font-size: 40rpx;
}

.level__item-name {
  display: block;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.level__item-need {
  display: block;
  margin-top: 4rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.level__item-benefit {
  display: block;
  margin-top: 4rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

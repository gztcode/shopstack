.tabs {
  display: flex;
  background: var(--ss-color-bg-card);
  box-shadow: var(--ss-shadow-xs);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs__item {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  position: relative;
}

.tabs__item--active {
  color: var(--ss-color-text-brand);
  font-weight: var(--ss-font-weight-semibold);
}

.tabs__item--active::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-brand-600);
}

/* 发票卡片 ------------------------------------------------------------ */
.invoice {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.invoice__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.invoice__title {
  flex: 1;
  min-width: 0;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.invoice__status {
  font-size: var(--ss-font-size-sm);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.invoice__status--success {
  color: var(--ss-color-text-success);
}

.invoice__status--warning {
  color: var(--ss-color-warning-600);
}

.invoice__status--danger {
  color: var(--ss-color-text-danger);
}

.invoice__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  font-size: var(--ss-font-size-sm);
}

.invoice__label {
  color: var(--ss-color-text-tertiary);
  flex-shrink: 0;
}

.invoice__value {
  color: var(--ss-color-text-secondary);
  text-align: right;
  word-break: break-all;
}

.invoice__remark {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.invoice__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ss-color-border-subtle);
}

.invoice__amount {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.invoice__btn {
  flex-shrink: 0;
}

/* 申请面板 ------------------------------------------------------------ */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--ss-z-index-overlay);
  background: var(--ss-color-bg-overlay);
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-xl) var(--ss-radius-xl) 0 0;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.panel__title {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.panel__close {
  font-size: 36rpx;
  color: var(--ss-color-text-tertiary);
  padding: 8rpx;
}

.panel__scroll {
  max-height: 62vh;
  flex: 1;
}

.panel__label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
}

.panel__input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: var(--ss-radius-md);
  background: var(--ss-color-bg-subtle);
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

.order {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-radius: var(--ss-radius-md);
  border: 1rpx solid var(--ss-color-border-subtle);
  background: var(--ss-color-bg-subtle);
}

.order__body {
  flex: 1;
  min-width: 0;
}

.order__no {
  display: block;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

.order__time {
  display: block;
  margin-top: 4rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.order__amount {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.order__radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--ss-radius-circle);
  border: 2rpx solid var(--ss-color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order__radio--on {
  background: var(--ss-color-brand-600);
  border-color: var(--ss-color-brand-600);
}

.order__check {
  color: var(--ss-color-text-inverse);
  font-size: 24rpx;
  line-height: 1;
}

.types {
  display: flex;
  gap: 16rpx;
}

.types__item {
  padding: 14rpx 40rpx;
  border-radius: var(--ss-radius-pill);
  border: 1rpx solid var(--ss-color-border-default);
  background: var(--ss-color-bg-subtle);
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.types__item--active {
  border-color: var(--ss-color-brand-600);
  background: var(--ss-color-brand-50);
  color: var(--ss-color-text-brand);
  font-weight: var(--ss-font-weight-semibold);
}

.panel__footer {
  margin-top: 20rpx;
}

.panel__confirm {
  width: 100%;
}

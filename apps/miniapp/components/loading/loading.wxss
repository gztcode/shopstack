.skeleton {
  padding: 24rpx;
}

.skeleton--grid {
  display: flex;
  flex-wrap: wrap;
}

.skeleton__card {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.skeleton__row {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.skeleton__lines {
  flex: 1;
  min-width: 0;
}

.skeleton__block {
  background: linear-gradient(90deg, #eef1f6 25%, #f6f8fb 37%, #eef1f6 63%);
  background-size: 400% 100%;
  border-radius: var(--ss-radius-sm);
  animation: skeleton-loading 1.4s ease infinite;
}

.skeleton__block--cover {
  width: 100%;
  height: 300rpx;
  border-radius: var(--ss-radius-lg);
}

.skeleton__block--hero {
  width: 100%;
  height: 640rpx;
  border-radius: var(--ss-radius-lg);
  margin-bottom: 24rpx;
}

.skeleton__block--thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--ss-radius-md);
  flex-shrink: 0;
}

.skeleton__block--line {
  width: 100%;
  height: 28rpx;
  margin-top: 16rpx;
}

.skeleton__block--short {
  width: 60%;
  margin-top: 12rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.trace__shipment {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.trace__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.trace__company {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.trace__no {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.trace__receiver {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
}

.trace__address {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.trace__time {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.trace__timeline {
  margin: 0 24rpx;
  padding: 24rpx;
}

.trace__node {
  display: flex;
  gap: 20rpx;
  padding-bottom: 32rpx;
  position: relative;
}

.trace__node:last-child {
  padding-bottom: 0;
}

.trace__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--ss-radius-circle);
  background: var(--ss-color-neutral-300);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.trace__dot--active {
  background: var(--ss-color-brand-600);
  box-shadow: 0 0 0 6rpx var(--ss-color-brand-50);
}

.trace__desc {
  display: block;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  line-height: var(--ss-font-line-height-relaxed);
}

.trace__desc--active {
  color: var(--ss-color-text-primary);
  font-weight: var(--ss-font-weight-semibold);
}

.trace__meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

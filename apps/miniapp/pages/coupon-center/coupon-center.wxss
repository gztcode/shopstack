.hero {
  padding: 32rpx 32rpx 36rpx;
  background: var(--ss-gradient-accent);
  color: var(--ss-color-text-inverse);
}

.hero__title {
  display: block;
  font-size: var(--ss-font-size-3xl);
  font-weight: var(--ss-font-weight-bold);
}

.hero__desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--ss-font-size-base);
  opacity: 0.9;
}

.hero__action {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--ss-radius-pill);
  background: rgba(255, 255, 255, 0.22);
  font-size: var(--ss-font-size-sm);
}

/* 优惠券卡片 ---------------------------------------------------------- */
.coupon {
  display: flex;
  align-items: stretch;
  margin: 24rpx 24rpx 0;
  overflow: hidden;
}

.coupon__left {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
}

.coupon__value {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  font-family: var(--ss-font-family-numeric);
  text-align: center;
}

.coupon__threshold {
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  opacity: 0.9;
  text-align: center;
}

.coupon__body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon__name {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.coupon__desc {
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
  line-height: var(--ss-font-line-height-relaxed);
}

.coupon__meta {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.coupon__right {
  width: 150rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 20rpx;
}

.coupon__btn {
  padding: 14rpx 24rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-gradient-accent);
  color: var(--ss-color-text-inverse);
  font-size: var(--ss-font-size-sm);
  font-weight: var(--ss-font-weight-semibold);
  box-shadow: var(--ss-shadow-sm);
}

.coupon__btn--disabled {
  background: var(--ss-color-neutral-300);
  color: var(--ss-color-text-inverse);
  box-shadow: none;
}

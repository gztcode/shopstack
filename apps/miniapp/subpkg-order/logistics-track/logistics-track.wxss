.query__form {
  margin: 24rpx 24rpx 0;
  padding: 8rpx 24rpx 24rpx;
}

.query__clear {
  padding: 0 8rpx;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-placeholder);
}

.query__btn {
  margin-top: 24rpx;
}

.query__result {
  margin: 0 24rpx;
  padding: 24rpx;
}

.query__result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.query__result-no {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

.query__node {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
}

.query__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--ss-radius-circle);
  background: var(--ss-color-neutral-300);
  margin-top: 10rpx;
  flex-shrink: 0;
}

.query__dot--active {
  background: var(--ss-color-brand-600);
  box-shadow: 0 0 0 6rpx var(--ss-color-brand-50);
}

.query__desc {
  display: block;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  line-height: var(--ss-font-line-height-relaxed);
}

.query__meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.query__empty {
  padding-top: 24rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.pay {
  padding-bottom: 0;
}

.amount {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 24rpx 48rpx;
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
}

.amount__label {
  font-size: var(--ss-font-size-base);
  opacity: 0.9;
}

.amount__value {
  margin-top: 12rpx;
  font-size: var(--ss-font-size-5xl);
  font-weight: var(--ss-font-weight-bold);
  font-family: var(--ss-font-family-numeric);
}

.amount__order {
  margin-top: 12rpx;
  font-size: var(--ss-font-size-sm);
  opacity: 0.85;
}

.block {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.block__title {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

/* 支付方式 ------------------------------------------------------------ */
.channel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.channel:last-child {
  border-bottom: none;
}

.channel__icon {
  font-size: 44rpx;
}

.channel__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.channel__label {
  font-size: var(--ss-font-size-lg);
  color: var(--ss-color-text-primary);
  font-weight: var(--ss-font-weight-medium);
}

.channel__desc {
  margin-top: 4rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.channel__radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--ss-radius-circle);
  border: 2rpx solid var(--ss-color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.channel__radio--on {
  background: var(--ss-color-brand-600);
  border-color: var(--ss-color-brand-600);
}

.channel__check {
  color: var(--ss-color-text-inverse);
  font-size: 26rpx;
  line-height: 1;
}

/* 说明 ---------------------------------------------------------------- */
.tips {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  border-radius: var(--ss-radius-lg);
  background: var(--ss-color-bg-muted);
}

.tips__title {
  display: block;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-secondary);
  margin-bottom: 10rpx;
}

.tips__item {
  display: block;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
  line-height: var(--ss-font-line-height-relaxed);
}

.bar__btn {
  flex: 1;
  height: 76rpx;
  font-size: var(--ss-font-size-base);
}

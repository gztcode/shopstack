<view class="ss-page pay-result">
  <demo-banner />

  <loading wx:if="{{loading}}" type="list" rows="2" />

  <block wx:if="{{!loading && payment}}">
    <view class="result">
      <text class="result__icon">{{icon}}</text>
      <text class="result__status">{{statusText}}</text>
      <text class="result__amount" wx:if="{{success}}">¥{{payment.amount_text}}</text>
      <text class="result__desc" wx:if="{{success}}">支付成功，商家将尽快为你发货</text>
      <text class="result__desc" wx:elif="{{payment.fail_reason}}">{{payment.fail_reason}}</text>
      <text class="result__desc" wx:else>支付未完成，可重新发起支付</text>
    </view>

    <view class="ss-card block">
      <text class="block__title">支付信息</text>
      <view class="info-row">
        <text class="info-row__label">支付单号</text>
        <text class="info-row__value">{{payment.payment_no}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">订单号</text>
        <text class="info-row__value">{{payment.order_no}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">支付渠道</text>
        <text class="info-row__value">{{payment.channel_text}}</text>
      </view>
      <view class="info-row">
        <text class="info-row__label">支付时间</text>
        <text class="info-row__value">{{payment.paid_text || '尚未支付'}}</text>
      </view>
      <view class="info-row" wx:if="{{payment.transaction_id}}">
        <text class="info-row__label">交易号</text>
        <text class="info-row__value">{{payment.transaction_id}}</text>
      </view>
    </view>

    <view class="ss-action-bar">
      <view class="ss-btn ss-btn--line ss-flex-1" bindtap="onContinue">继续购物</view>
      <view class="ss-btn ss-btn--line ss-flex-1" wx:if="{{!success}}" bindtap="onRepay">重新支付</view>
      <view class="ss-btn ss-btn--primary ss-flex-1" wx:if="{{success}}" bindtap="onViewOrder">查看订单</view>
    </view>
  </block>

  <empty-state
    wx:if="{{!loading && !payment}}"
    icon="🧾"
    title="{{error || '未找到支付记录'}}"
    desc="可返回订单详情重新发起支付"
    actionText="重新查询"
    bind:action="onRetry"
  />
</view>

.summary {
  padding: 40rpx 32rpx;
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
}

.summary__label {
  display: block;
  font-size: var(--ss-font-size-base);
  opacity: 0.9;
}

.summary__value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-5xl);
  font-weight: var(--ss-font-weight-bold);
  font-family: var(--ss-font-family-numeric);
}

.summary__row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.summary__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary__num {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  font-family: var(--ss-font-family-numeric);
}

.summary__num--minus {
  opacity: 0.85;
}

.summary__text {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-sm);
  opacity: 0.85;
}

.summary__split {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 明细条目 ------------------------------------------------------------ */
.log {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.log__body {
  flex: 1;
  min-width: 0;
}

.log__title {
  display: block;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.log__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.log__time {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.log__order {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.log__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.log__change {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.log__change--plus {
  color: var(--ss-color-text-success);
}

.log__balance {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

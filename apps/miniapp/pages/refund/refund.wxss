.block {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.block__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

/* 订单选择 ------------------------------------------------------------ */
.order {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 24rpx 0;
  padding: 24rpx;
}

.order + .order {
  margin-top: 16rpx;
}

.order__body {
  flex: 1;
  min-width: 0;
}

.order__no {
  display: block;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-medium);
  color: var(--ss-color-text-primary);
}

.order__meta {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.order__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.order__status {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-brand);
}

.order__amount {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.order__radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--ss-radius-circle);
  border: 2rpx solid var(--ss-color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order__radio--on {
  background: var(--ss-color-brand-600);
  border-color: var(--ss-color-brand-600);
}

.order__check {
  color: var(--ss-color-text-inverse);
  font-size: 26rpx;
  line-height: 1;
}

/* 表单 ---------------------------------------------------------------- */
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.field__label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.field__picker {
  flex: 1;
  min-width: 0;
}

.field__value {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
  text-align: right;
}

.field__input {
  flex: 1;
  min-width: 0;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
  text-align: right;
}

.field__hint {
  display: block;
  padding: 10rpx 0 4rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
  text-align: right;
}

.submit {
  width: 100%;
  margin-top: 24rpx;
}

/* 提交结果 ------------------------------------------------------------ */
.result {
  background: var(--ss-color-success-50);
}

.result__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 8rpx 0;
  font-size: var(--ss-font-size-sm);
}

.result__label {
  color: var(--ss-color-text-tertiary);
}

.result__value {
  color: var(--ss-color-text-secondary);
  text-align: right;
}

<view class="ss-page address-edit">
  <nav-bar title="{{addressId ? '编辑地址' : '新增地址'}}" />

  <demo-banner />

  <loading wx:if="{{loading}}" type="list" rows="2" />

  <block wx:if="{{!loading}}">
    <view class="ss-card form">
      <view class="ss-field">
        <text class="ss-field__label">收货人</text>
        <input
          class="ss-field__input"
          placeholder="请输入收货人姓名"
          placeholder-class="ss-placeholder"
          value="{{receiver}}"
          data-field="receiver"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">手机号</text>
        <input
          class="ss-field__input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          placeholder-class="ss-placeholder"
          value="{{phone}}"
          data-field="phone"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">省份</text>
        <input
          class="ss-field__input"
          placeholder="如：浙江省"
          placeholder-class="ss-placeholder"
          value="{{province}}"
          data-field="province"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">城市</text>
        <input
          class="ss-field__input"
          placeholder="如：杭州市"
          placeholder-class="ss-placeholder"
          value="{{city}}"
          data-field="city"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">区县</text>
        <input
          class="ss-field__input"
          placeholder="如：西湖区"
          placeholder-class="ss-placeholder"
          value="{{district}}"
          data-field="district"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">详细地址</text>
        <input
          class="ss-field__input"
          placeholder="街道、楼牌号等"
          placeholder-class="ss-placeholder"
          value="{{detail}}"
          data-field="detail"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">邮政编码</text>
        <input
          class="ss-field__input"
          type="number"
          placeholder="选填"
          placeholder-class="ss-placeholder"
          value="{{postalCode}}"
          data-field="postalCode"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="ss-card block">
      <text class="block__title">地址标签</text>
      <view class="tags">
        <view
          class="tags__item {{tag === item ? 'tags__item--active' : ''}}"
          wx:for="{{tags}}"
          wx:key="*this"
          data-tag="{{item}}"
          bindtap="onTagTap"
        >
          {{item}}
        </view>
      </view>
      <view class="default" bindtap="onToggleDefault">
        <text class="default__label">设为默认地址</text>
        <switch checked="{{isDefault}}" color="#2A4AD9" />
      </view>
    </view>

    <view class="ss-action-bar__spacer"></view>

    <view class="ss-action-bar">
      <view class="ss-btn ss-btn--primary ss-flex-1 {{saving ? 'ss-btn--disabled' : ''}}" bindtap="onSave">
        {{saving ? '保存中…' : '保存地址'}}
      </view>
    </view>
  </block>
</view>

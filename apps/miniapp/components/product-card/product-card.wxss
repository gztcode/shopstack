.card {
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-lg);
  box-shadow: var(--ss-shadow-sm);
  overflow: hidden;
}

.cover-wrap {
  position: relative;
  width: 100%;
  height: 340rpx;
  background: var(--ss-color-bg-muted);
}

.cover {
  width: 100%;
  height: 100%;
}

.cover__tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--ss-radius-xs);
  background: var(--ss-color-accent-500);
  color: var(--ss-color-text-inverse);
  font-size: var(--ss-font-size-xs);
}

.body {
  padding: 16rpx;
}

/* 单行 / 两行省略（组件样式隔离，需在组件内自行定义） */
.ss-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ss-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.title {
  display: block;
  min-height: 76rpx;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-medium);
  color: var(--ss-color-text-primary);
  line-height: 1.4;
}

.subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 14rpx;
}

.price {
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
  font-weight: var(--ss-font-weight-bold);
  font-size: var(--ss-font-size-xl);
}

.origin {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-quaternary);
  text-decoration: line-through;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.sales {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.add {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--ss-radius-circle);
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--ss-shadow-brand);
}

.add__icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 紧凑模式 ------------------------------------------------------------ */
.card--compact {
  display: flex;
}

.card--compact .cover-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.card--compact .body {
  flex: 1;
  min-width: 0;
}

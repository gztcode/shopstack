.tasks__head {
  padding: 28rpx 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tasks__title {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-primary);
}

.tasks__desc {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.tasks__list {
  padding: 12rpx 24rpx 0;
}

.tasks__card {
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-lg);
  box-shadow: var(--ss-shadow-xs);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.tasks__top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tasks__name {
  display: block;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.tasks__desc-text {
  display: block;
  margin-top: 6rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.tasks__reward {
  flex-shrink: 0;
  font-size: var(--ss-font-size-sm);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-danger);
}

.tasks__progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tasks__bar {
  flex: 1;
  height: 12rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-bg-muted);
  overflow: hidden;
}

.tasks__bar-inner {
  height: 100%;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-gradient-brand);
}

.tasks__progress-text {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.tasks__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.nav {
  width: 100%;
}

.nav__bar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.nav__bar--border {
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav__back--placeholder {
  opacity: 0;
}

.nav__back-icon {
  font-size: 52rpx;
  line-height: 1;
  color: var(--ss-color-text-primary);
}

.nav__title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
  pointer-events: none;
}

.nav__right {
  margin-left: auto;
  z-index: 1;
  display: flex;
  align-items: center;
}

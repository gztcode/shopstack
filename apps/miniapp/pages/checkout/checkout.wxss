.checkout {
  padding-bottom: 0;
}

.block {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.block__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row--between {
  justify-content: space-between;
}

.row__label {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.row__value {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

/* 地址 ---------------------------------------------------------------- */
.address {
  flex: 1;
  min-width: 0;
}

.address__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address__name {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.address__phone {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

.address__detail {
  display: block;
  margin-top: 10rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.address--empty {
  padding: 12rpx 0;
}

.address__none {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-tertiary);
}

.address__arrow {
  font-size: 36rpx;
  color: var(--ss-color-text-placeholder);
}

/* 商品清单 ------------------------------------------------------------ */
.goods {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.goods__img {
  width: 150rpx;
  height: 150rpx;
  border-radius: var(--ss-radius-md);
  background: var(--ss-color-bg-muted);
  flex-shrink: 0;
}

.goods__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods__title {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
  line-height: 1.4;
}

.goods__spec {
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.goods__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.goods__price {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.goods__qty {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

/* 金额明细 ------------------------------------------------------------ */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: var(--ss-font-size-base);
}

.amount-row__label {
  color: var(--ss-color-text-secondary);
}

.amount-row__value {
  color: var(--ss-color-text-primary);
  font-family: var(--ss-font-family-numeric);
}

.amount-row__value--cut {
  color: var(--ss-color-text-danger);
}

.amount-row--total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ss-color-border-subtle);
}

.amount-row__total {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

/* 底部栏 -------------------------------------------------------------- */
.bar__amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.bar__label {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
}

.bar__price {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
  font-family: var(--ss-font-family-numeric);
}

.bar__count {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.bar__btn {
  width: 240rpx;
  height: 76rpx;
  font-size: var(--ss-font-size-base);
}

/* 优惠券面板 ---------------------------------------------------------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--ss-z-index-overlay);
  background: var(--ss-color-bg-overlay);
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-xl) var(--ss-radius-xl) 0 0;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.panel__title {
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.panel__close {
  font-size: 36rpx;
  color: var(--ss-color-text-tertiary);
  padding: 8rpx;
}

.panel__scroll {
  max-height: 56vh;
}

.panel__none {
  padding: 20rpx 0;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
}

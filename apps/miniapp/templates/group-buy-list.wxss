.group__head {
  padding: 28rpx 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.group__title {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-primary);
}

.group__desc {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.group__list {
  padding: 0 24rpx;
}

.group__card {
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-lg);
  box-shadow: var(--ss-shadow-xs);
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.group__top {
  display: flex;
  gap: 16rpx;
}

.group__cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--ss-radius-md);
  background: var(--ss-color-bg-muted);
  flex-shrink: 0;
}

.group__name {
  display: block;
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

.group__price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
}

.group__price {
  font-size: var(--ss-font-size-xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-danger);
}

.group__origin {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-quaternary);
  text-decoration: line-through;
}

.group__end {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-xs);
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.group__progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.group__bar {
  flex: 1;
  height: 12rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-bg-muted);
  overflow: hidden;
}

.group__bar-inner {
  height: 100%;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-gradient-accent);
}

.group__progress-text {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.group__members {
  display: block;
  margin-top: 12rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
}

.group__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ss-color-border-subtle);
}

.group__actions {
  display: flex;
  gap: 12rpx;
}

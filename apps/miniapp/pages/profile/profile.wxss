.profile {
  padding-bottom: 40rpx;
}

/* 用户信息卡 ---------------------------------------------------------- */
.user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx;
  background: var(--ss-gradient-hero);
  color: var(--ss-color-text-inverse);
}

.user__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--ss-radius-circle);
  background: var(--ss-color-neutral-100);
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.user__info {
  flex: 1;
  min-width: 0;
}

.user__name {
  display: block;
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
}

.user__desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  opacity: 0.85;
}

.user__arrow {
  font-size: 40rpx;
  opacity: 0.8;
}

/* 资产 ---------------------------------------------------------------- */
.assets {
  margin: 24rpx 24rpx 0;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
}

.assets__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.assets__value {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-primary);
  font-family: var(--ss-font-family-numeric);
}

.assets__value--icon {
  font-size: 44rpx;
}

.assets__label {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.assets__divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--ss-color-border-subtle);
}

/* 通用块 -------------------------------------------------------------- */
.block {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.block__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.block__title {
  display: block;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
  margin-bottom: 16rpx;
}

.block__more {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

/* 订单入口 ------------------------------------------------------------ */
.orders {
  display: flex;
}

.orders__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.orders__icon-wrap {
  position: relative;
}

.orders__icon {
  font-size: 44rpx;
  line-height: 1;
}

.orders__badge {
  position: absolute;
  top: -8rpx;
  right: -20rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-danger-500);
  color: var(--ss-color-text-inverse);
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.orders__label {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
}

/* 功能宫格 ------------------------------------------------------------ */
.menu {
  display: flex;
  flex-wrap: wrap;
}

.menu__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0;
}

.menu__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--ss-radius-lg);
  background: var(--ss-color-brand-50);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.menu__label {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-secondary);
}

/* 退出登录 ------------------------------------------------------------ */
.logout {
  margin: 40rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-bg-card);
  color: var(--ss-color-text-danger);
  font-size: var(--ss-font-size-lg);
  box-shadow: var(--ss-shadow-xs);
}

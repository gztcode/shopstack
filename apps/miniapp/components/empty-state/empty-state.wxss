.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty__icon {
  font-size: 96rpx;
  line-height: 1;
}

.empty__title {
  margin-top: 24rpx;
  font-size: var(--ss-font-size-lg);
  color: var(--ss-color-text-secondary);
  font-weight: var(--ss-font-weight-medium);
}

.empty__desc {
  margin-top: 12rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
  text-align: center;
}

.empty__btn {
  margin-top: 32rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-semibold);
  box-shadow: var(--ss-shadow-brand);
}

<view class="ss-page login">
  <nav-bar title="登录 / 注册" />

  <demo-banner />

  <view class="hero">
    <text class="hero__title">欢迎来到 ShopStack</text>
    <text class="hero__desc">登录后可同步购物车、订单与优惠券</text>
  </view>

  <view class="tabs">
    <view class="tabs__item {{mode === 'login' ? 'tabs__item--active' : ''}}" data-mode="login" bindtap="onModeTap">
      账号登录
    </view>
    <view class="tabs__item {{mode === 'register' ? 'tabs__item--active' : ''}}" data-mode="register" bindtap="onModeTap">
      注册账号
    </view>
  </view>

  <view class="ss-card form">
    <view class="ss-field">
      <text class="ss-field__label">账号</text>
      <input
        class="ss-field__input"
        placeholder="请输入用户名"
        placeholder-class="ss-placeholder"
        value="{{username}}"
        data-field="username"
        bindinput="onInput"
      />
    </view>
    <view class="ss-field">
      <text class="ss-field__label">密码</text>
      <input
        class="ss-field__input"
        password
        placeholder="请输入密码"
        placeholder-class="ss-placeholder"
        value="{{password}}"
        data-field="password"
        bindinput="onInput"
      />
    </view>

    <block wx:if="{{mode === 'register'}}">
      <view class="ss-field">
        <text class="ss-field__label">确认密码</text>
        <input
          class="ss-field__input"
          password
          placeholder="请再次输入密码"
          placeholder-class="ss-placeholder"
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">手机号</text>
        <input
          class="ss-field__input"
          type="number"
          placeholder="选填"
          placeholder-class="ss-placeholder"
          value="{{phone}}"
          data-field="phone"
          bindinput="onInput"
        />
      </view>
      <view class="ss-field">
        <text class="ss-field__label">昵称</text>
        <input
          class="ss-field__input"
          placeholder="选填"
          placeholder-class="ss-placeholder"
          value="{{nickname}}"
          data-field="nickname"
          bindinput="onInput"
        />
      </view>
    </block>

    <view class="form__submit">
      <view
        class="ss-btn ss-btn--primary form__btn {{submitting ? 'ss-btn--disabled' : ''}}"
        wx:if="{{mode === 'login'}}"
        bindtap="onLogin"
      >
        {{submitting ? '登录中…' : '登录'}}
      </view>
      <view
        class="ss-btn ss-btn--primary form__btn {{submitting ? 'ss-btn--disabled' : ''}}"
        wx:else
        bindtap="onRegister"
      >
        {{submitting ? '注册中…' : '注册并登录'}}
      </view>
    </view>

    <view class="form__divider">
      <view class="form__line"></view>
      <text class="form__line-text">其他方式</text>
      <view class="form__line"></view>
    </view>

    <view class="form__wechat" bindtap="onWechatLogin">微信一键登录</view>
  </view>

  <view class="tip">
    <text class="tip__text">演示账号：demo / demo123456</text>
  </view>
</view>

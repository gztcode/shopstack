<view class="ss-page history">
  <demo-banner />

  <view class="head" wx:if="{{items.length}}">
    <text class="head__text">共浏览 {{items.length}} 件商品</text>
    <text class="head__clear" bindtap="onClear">清空</text>
  </view>

  <view class="ss-card item" wx:for="{{items}}" wx:key="product_id">
    <image class="item__img" src="{{item.cover}}" mode="aspectFill" data-id="{{item.product_id}}" bindtap="onItemTap" />
    <view class="item__body" data-id="{{item.product_id}}" bindtap="onItemTap">
      <text class="item__title ss-ellipsis-2">{{item.title}}</text>
      <view class="item__meta">
        <text class="item__price">¥{{item.price_text}}</text>
        <text class="item__time">{{item.viewed_text}}</text>
      </view>
      <text class="item__category" wx:if="{{item.category_name}}">{{item.category_name}}</text>
    </view>
    <text class="item__remove" data-id="{{item.product_id}}" catchtap="onDelete">删除</text>
  </view>

  <empty-state
    wx:if="{{!items.length}}"
    icon="🕘"
    title="还没有浏览记录"
    desc="浏览过的商品会出现在这里"
    actionText="去逛逛"
    bind:action="onGoShopping"
  />
</view>

.coupon {
  display: flex;
  align-items: stretch;
  background: var(--ss-color-bg-card);
  border-radius: var(--ss-radius-md);
  overflow: hidden;
  box-shadow: var(--ss-shadow-xs);
  margin-bottom: 16rpx;
}

.coupon--disabled {
  opacity: 0.55;
}

.coupon__left {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  background: var(--ss-gradient-brand);
  color: var(--ss-color-text-inverse);
}

.coupon--disabled .coupon__left {
  background: var(--ss-color-neutral-300);
}

.coupon__value {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  font-family: var(--ss-font-family-numeric);
}

.coupon__threshold {
  margin-top: 6rpx;
  font-size: var(--ss-font-size-xs);
  opacity: 0.9;
}

.coupon__body {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon__name {
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.coupon__period {
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.coupon__right {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding-right: 20rpx;
}

.coupon__status {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-tertiary);
}

.coupon__radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--ss-radius-circle);
  border: 2rpx solid var(--ss-color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon__radio--on {
  background: var(--ss-color-brand-600);
  border-color: var(--ss-color-brand-600);
}

.coupon__check {
  color: var(--ss-color-text-inverse);
  font-size: 24rpx;
  line-height: 1;
}

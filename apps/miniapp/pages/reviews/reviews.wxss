.tabs {
  display: flex;
  background: var(--ss-color-bg-card);
  box-shadow: var(--ss-shadow-xs);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs__item {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  position: relative;
}

.tabs__item--active {
  color: var(--ss-color-text-brand);
  font-weight: var(--ss-font-weight-semibold);
}

.tabs__item--active::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: var(--ss-radius-pill);
  background: var(--ss-color-brand-600);
}

.block {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.block__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--ss-font-size-lg);
  font-weight: var(--ss-font-weight-semibold);
  color: var(--ss-color-text-primary);
}

/* 商品选择 ------------------------------------------------------------ */
.goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.goods__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--ss-radius-md);
  background: var(--ss-color-bg-muted);
  flex-shrink: 0;
}

.goods__body {
  flex: 1;
  min-width: 0;
}

.goods__title {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
  line-height: 1.4;
}

.goods__spec {
  display: block;
  margin-top: 8rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.goods__radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--ss-radius-circle);
  border: 2rpx solid var(--ss-color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.goods__radio--on {
  background: var(--ss-color-brand-600);
  border-color: var(--ss-color-brand-600);
}

.goods__check {
  color: var(--ss-color-text-inverse);
  font-size: 26rpx;
  line-height: 1;
}

/* 规格 ---------------------------------------------------------------- */
.skus {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skus__item {
  padding: 12rpx 24rpx;
  border-radius: var(--ss-radius-md);
  border: 1rpx solid var(--ss-color-border-default);
  background: var(--ss-color-bg-subtle);
  display: flex;
  flex-direction: column;
}

.skus__item--active {
  border-color: var(--ss-color-brand-600);
  background: var(--ss-color-brand-50);
}

.skus__text {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

.skus__price {
  margin-top: 4rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-danger);
}

/* 评分与图片 ---------------------------------------------------------- */
.stars {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stars__item {
  font-size: 48rpx;
  color: var(--ss-color-neutral-300);
  line-height: 1;
}

.stars__item--on {
  color: var(--ss-color-accent-500);
}

.stars__text {
  margin-left: 12rpx;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.images__item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.images__img {
  width: 100%;
  height: 100%;
  border-radius: var(--ss-radius-md);
  background: var(--ss-color-bg-muted);
}

.images__remove {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--ss-radius-circle);
  background: rgba(18, 27, 38, 0.6);
  color: var(--ss-color-text-inverse);
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.images__add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--ss-radius-md);
  border: 2rpx dashed var(--ss-color-border-default);
  background: var(--ss-color-bg-subtle);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.images__plus {
  font-size: 44rpx;
  color: var(--ss-color-text-placeholder);
  line-height: 1;
}

.images__hint {
  margin-top: 8rpx;
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-placeholder);
}

.submit {
  width: 100%;
}

/* 评价列表 ------------------------------------------------------------ */
.review {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}

.review__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review__nickname {
  font-size: var(--ss-font-size-base);
  font-weight: var(--ss-font-weight-medium);
  color: var(--ss-color-text-primary);
}

.review__stars {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-accent-500);
}

.review__content {
  display: block;
  margin-top: 12rpx;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-secondary);
  line-height: var(--ss-font-line-height-relaxed);
}

.review__images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.review__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--ss-radius-sm);
  background: var(--ss-color-bg-muted);
}

.review__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ss-color-border-subtle);
}

.review__product {
  flex: 1;
  min-width: 0;
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.review__time {
  font-size: var(--ss-font-size-xs);
  color: var(--ss-color-text-quaternary);
  flex-shrink: 0;
}

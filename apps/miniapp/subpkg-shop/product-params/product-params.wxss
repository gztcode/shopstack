.params__head {
  padding: 28rpx 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.params__title {
  font-size: var(--ss-font-size-2xl);
  font-weight: var(--ss-font-weight-bold);
  color: var(--ss-color-text-primary);
}

.params__subtitle {
  font-size: var(--ss-font-size-sm);
  color: var(--ss-color-text-tertiary);
}

.params__card {
  margin: 12rpx 24rpx 0;
  padding: 8rpx 24rpx;
}

.params__row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--ss-color-border-subtle);
}

.params__row:last-child {
  border-bottom: none;
}

.params__name {
  width: 160rpx;
  flex-shrink: 0;
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-tertiary);
}

.params__value {
  font-size: var(--ss-font-size-base);
  color: var(--ss-color-text-primary);
}

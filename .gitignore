/smoketest

# 依赖
node_modules/
.pub-cache/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# 环境
.env
.env.local
.env.*.local
*.log

# 编辑器
.idea/
.vscode/
*.iml
.DS_Store

    },
    {
      "root": "subpkg-order",
      "pages": [
        "sign-in-calendar/sign-in-calendar",
        "task-center/task-center",
        "task-detail/task-detail",
        "promotion-list/promotion-list",
        "promotion-flash/promotion-flash",
        "promotion-presale/promotion-presale",
        "group-buy-list/group-buy-list",
        "group-buy-detail/group-buy-detail",
        "group-buy-join/group-buy-join",
        "promotion-session/promotion-session",

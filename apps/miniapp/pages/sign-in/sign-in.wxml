<view class="ss-page sign">
  <demo-banner />

  <view class="sign__hero">
    <text class="sign__hero-title">每日签到</text>
    <text class="sign__hero-sub">连续签到奖励更多积分</text>
    <view class="sign__stats">
      <view class="sign__stat">
        <text class="sign__stat-value">{{continuousDays}}</text>
        <text class="sign__stat-label">连续签到（天）</text>
      </view>
      <view class="sign__stat">
        <text class="sign__stat-value">{{pointsAwarded}}</text>
        <text class="sign__stat-label">今日获得</text>
      </view>
      <view class="sign__stat">
        <text class="sign__stat-value">{{totalPoints}}</text>
        <text class="sign__stat-label">当前积分</text>
      </view>
    </view>
    <view
      class="ss-btn sign__btn {{signedToday ? 'sign__btn--done' : 'ss-btn--accent'}}"
      bindtap="onSignIn"
    >
      {{signedToday ? '今日已签到' : (signing ? '签到中' : '立即签到 +' + nextPoints + ' 积分')}}
    </view>
  </view>

  <view class="ss-section-title">
    <text>最近签到</text>
    <text class="ss-section-title__more" bindtap="onGoCalendar">签到日历 ›</text>
  </view>

  <view class="ss-card sign__records">
    <view class="sign__record" wx:for="{{records}}" wx:key="date">
      <text class="sign__record-date">{{item.date}}</text>
      <text class="sign__record-points" wx:if="{{item.signed}}">+{{item.points}}</text>
      <text class="sign__record-points" wx:else>未签到</text>
    </view>
    <view class="sign__record sign__record--empty" wx:if="{{!records.length}}">
      <text class="sign__record-date">还没有签到记录</text>
      <text class="sign__record-points">快来签到</text>
    </view>
  </view>

  <view class="ss-card sign__links">
    <view class="ss-list-item" bindtap="onGoTasks">
      <view class="ss-list-item__icon">📋</view>
      <view class="ss-flex-1">
        <text class="sign__link-title">任务中心</text>
        <text class="sign__link-desc">做任务赚积分</text>
      </view>
      <text class="sign__arrow">›</text>
    </view>
    <view class="ss-list-item" bindtap="onGoPoints">
      <view class="ss-list-item__icon">💎</view>
      <view class="ss-flex-1">
        <text class="sign__link-title">积分明细</text>
        <text class="sign__link-desc">查看积分收支记录</text>
      </view>
      <text class="sign__arrow">›</text>
    </view>
  </view>
</view>
